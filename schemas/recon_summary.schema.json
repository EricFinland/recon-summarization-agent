{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recon_summary.schema.json",
  "title": "ReconSummary",
  "description": "DRAFT v0.1. Output contract between the recon summarization agent and Group 2's classification agent. Every fact must come from the input scan file; observations carry an 'evidence' path pointing back to it. Agree changes with Group 2 and bump schema_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "overview", "hosts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this contract (semver).",
      "const": "0.1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the agent produced this summary (UTC)."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_file", "scan_id"],
      "properties": {
        "scan_file": { "type": "string", "description": "Input file name the summary was built from." },
        "scan_id": { "type": ["string", "null"], "description": "scan_id from the input, if present." },
        "target_range": { "type": ["string", "null"], "description": "Scanned range from the input, if present." }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts_total", "hosts_up", "open_ports_total", "summary_text"],
      "properties": {
        "hosts_total": { "type": "integer", "minimum": 0 },
        "hosts_up": { "type": "integer", "minimum": 0 },
        "open_ports_total": { "type": "integer", "minimum": 0 },
        "summary_text": {
          "type": "string",
          "description": "Short plain-language overview. May only restate facts found in the input."
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "hostname", "status", "os_guess", "open_ports", "other_ports", "observations"],
      "properties": {
        "ip": { "type": "string" },
        "hostname": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["up", "down", "unknown"] },
        "os_guess": { "type": ["string", "null"], "description": "Copied from input; null if the input has none. Never inferred." },
        "open_ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/open_port" }
        },
        "other_ports": {
          "type": "array",
          "description": "Closed or filtered ports, kept so nothing in the input is silently dropped.",
          "items": { "$ref": "#/$defs/other_port" }
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "open_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "protocol", "service", "product", "version"],
      "properties": {
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp", "udp"] },
        "service": { "type": ["string", "null"] },
        "product": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] }
      }
    },
    "other_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "protocol", "state", "service"],
      "properties": {
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp", "udp"] },
        "state": { "type": "string", "enum": ["closed", "filtered", "open|filtered", "unknown"] },
        "service": { "type": ["string", "null"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "description": "The observation, restated without adding new claims." },
        "evidence": {
          "type": "string",
          "description": "Path into the input file that supports this observation, e.g. 'hosts[0].notes[1]'."
        }
      }
    }
  }
}
