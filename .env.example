# Copy this file to .env and fill in values. Never commit .env.
# Real environment variables take precedence over values in .env.

# ---------------------------------------------------------------------------
# LLM narrator (optional). It only writes overview.summary_text.
#   none   = no LLM; deterministic template (default, works offline and in CI)
#   gemini = Google Gemini Flash via google-genai (needs LLM_MODEL and LLM_API_KEY)
#   ollama = local Ollama server (needs LLM_MODEL; no API key)
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Timeout in seconds for each LLM request.
LLM_TIMEOUT_S=30
# Only used when LLM_PROVIDER=ollama. From Docker on Windows/macOS use
# http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Gemini example (data is synthetic, so a hosted model is allowed). Model names
# change: check Google AI Studio (https://aistudio.google.com) for the current
# Flash model and pin it. Prefer the cheapest Flash tier.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your-google-ai-studio-key

# Ollama example (fully local). Pull the model first: ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Paths and limits (defaults work locally and inside Docker)
# ---------------------------------------------------------------------------
SCAN_INPUT_DIR=data/scans
OUTPUT_DIR=output
# Append-only JSON Lines audit trail (defaults to OUTPUT_DIR/audit.log.jsonl).
AUDIT_LOG_PATH=output/audit.log.jsonl
# Scan files larger than this many bytes are rejected before parsing.
MAX_INPUT_BYTES=5000000
